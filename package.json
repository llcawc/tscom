{
  "name": "tscom",
  "version": "0.0.9",
  "description": "bundling, compiling, and minifying javascript or typescript files",
  "keywords": [
    "bundle",
    "compile",
    "javascript",
    "minify",
    "rolldown",
    "typescript"
  ],
  "homepage": "https://github.com/llcawc/tscom",
  "license": "MIT",
  "author": "llcawc",
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/tscom.cjs",
  "module": "./dist/tscom.js",
  "types": "./dist/tscom.d.cts",
  "exports": {
    ".": {
      "import": "./dist/tscom.js",
      "require": "./dist/tscom.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "validate": "tsc --noEmit && vitest --run",
    "tscheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "plugin-error": "^2.0.1",
    "rolldown": "1.0.0-rc.13",
    "terser": "^5.46.1",
    "tinyglobby": "^0.2.15",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/picomatch": "^4.0.3",
    "@types/vinyl": "^2.0.12",
    "@typescript/native-preview": "7.0.0-dev.20260406.1",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsdown": "^0.21.7",
    "vinyl": "^3.0.1",
    "vitest": "^4.1.2"
  }
}
