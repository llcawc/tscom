{
  "name": "tscom",
  "version": "0.0.8",
  "description": "bundling, compiling, and minifying javascript or typescript files",
  "keywords": [
    "compile",
    "javascript",
    "typescript",
    "bundle",
    "minify",
    "rollup",
    "babel"
  ],
  "license": "MIT",
  "author": "llcawc",
  "homepage": "https://github.com/llcawc/tscom",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/tscom.js",
      "require": "./dist/tscom.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "validate": "tsc --noEmit && vitest --run",
    "tscheck": "tsc --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vinyl": "^2.0.12",
    "@typescript/native-preview": "7.0.0-dev.20260327.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "tsdown": "^0.21.5",
    "vinyl": "^3.0.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "glob": "^13.0.6",
    "plugin-error": "^2.0.1",
    "rolldown": "1.0.0-rc.12",
    "typescript": "^6.0.2"
  },
  "main": "./dist/tscom.cjs",
  "module": "./dist/tscom.js",
  "types": "./dist/tscom.d.cts"
}
